<Window x:Class="KopiStock.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="KopiStock — Gudang Utama" Width="1480" Height="920" MinWidth="1150" MinHeight="730" Background="{StaticResource Cream}" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display">
<Grid>
  <ContentControl x:Name="LoginHost"/>
  <Grid x:Name="Shell" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="234"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource Coffee}">
     <DockPanel Margin="16,25,16,18" LastChildFill="True">
      <StackPanel DockPanel.Dock="Top" Margin="11,0,0,27"><TextBlock Text="◌  KopiStock" FontSize="25" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="INVENTORI KOPI" Foreground="{StaticResource DarkMuted}" FontSize="10" Margin="34,2,0,0"/></StackPanel>
      <StackPanel DockPanel.Dock="Bottom">
       <Border Background="#412F27" CornerRadius="9" Padding="13" Margin="0,0,0,18"><StackPanel><TextBlock Text="⌂" Foreground="{StaticResource Latte}" FontSize="23"/><TextBlock Text="Gudang Utama" Foreground="White" FontWeight="SemiBold" FontSize="12" Margin="0,3,0,7"/><TextBlock Text="Satu lokasi. Catatan stok yang tertata." Foreground="{StaticResource DarkMuted}" FontSize="11"/></StackPanel></Border>
       <TextBlock Text="AKUN &amp; BANTUAN" Foreground="{StaticResource DarkMuted}" FontSize="10" Margin="0,0,0,8"/>
       <Button x:Name="NavProfile" Content="♙   Profil" Style="{StaticResource SidebarButton}" Click="Profile_Click"/>
       <Button x:Name="NavSettings" Content="⚙   Pengaturan" Style="{StaticResource SidebarButton}" Click="Settings_Click"/>
       <Button x:Name="NavHelp" Content="ⓘ   Pusat Bantuan" Style="{StaticResource SidebarButton}" Click="Help_Click"/>
       <Button Content="⇥   Keluar" Style="{StaticResource SidebarButton}" Click="Logout_Click"/>
       <Border Height="1" Background="#5A4338" Margin="0,16,0,10"/>
       <StackPanel Orientation="Horizontal" Margin="3,0,0,0"><Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource CoffeeSoft}"><TextBlock Text="AG" Foreground="White" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="9,0,0,0"><TextBlock x:Name="SideUser" Text="Admin Gudang" Foreground="White" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Administrator" Foreground="{StaticResource DarkMuted}" FontSize="10"/></StackPanel></StackPanel>
      </StackPanel>
      <StackPanel><TextBlock Text="RUANG KERJA" Foreground="{StaticResource DarkMuted}" FontSize="10" Margin="0,0,0,7"/>
       <Button x:Name="NavDashboard" Content="▦   Dashboard" Style="{StaticResource SidebarButton}" Click="Dashboard_Click"/>
       <Button x:Name="NavMaster" Content="▤   Master Data" Style="{StaticResource SidebarButton}" Click="Master_Click"/>
       <Button x:Name="NavReceiving" Content="◈   Penerimaan" Style="{StaticResource SidebarButton}" Click="Receiving_Click"/>
       <Button x:Name="NavStock" Content="⬡   Stok &amp; Pengeluaran" Style="{StaticResource SidebarButton}" Click="Stock_Click"/>
       <Button x:Name="NavHistory" Content="◷   Riwayat" Style="{StaticResource SidebarButton}" Click="History_Click"/>
      </StackPanel>
     </DockPanel>
    </Border>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
       <Grid Margin="31,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="KopiStock" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="   /   " Foreground="{StaticResource Latte}" FontSize="12"/><TextBlock x:Name="HeaderTitle" Text="Dashboard" Foreground="{StaticResource Ink}" FontWeight="SemiBold" FontSize="12"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{StaticResource SoftLatte}" CornerRadius="6" Padding="9,4" Margin="0,0,15,0"><TextBlock Text="Gudang Utama" Foreground="{StaticResource Mocha}" FontSize="11" FontWeight="SemiBold"/></Border><TextBlock x:Name="HeaderDate" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/></StackPanel>
       </Grid>
      </Border>
      <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="31,30,31,18"><ContentControl x:Name="MainContent"/><Grid Margin="0,18,0,3"><TextBlock Text="Gudang Utama · Satuan berat dalam kg" Style="{StaticResource MutedText}" HorizontalAlignment="Left"/><TextBlock Text="KopiStock / 1.0" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></Grid></StackPanel></ScrollViewer>
    </Grid>
  </Grid>
</Grid>
</Window>
