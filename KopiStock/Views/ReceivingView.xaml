<UserControl x:Class="KopiStock.Views.ReceivingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<StackPanel><TextBlock Text="Penerimaan kopi" Style="{StaticResource H1}"/><TextBlock Text="Catat lot baru yang masuk ke Gudang Utama." Style="{StaticResource MutedText}" FontSize="13" Margin="0,0,0,23"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
  <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0"><StackPanel>
   <StackPanel Margin="22,20,22,17"><TextBlock Text="Informasi penerimaan" Style="{StaticResource Subheading}"/><TextBlock Text="* Wajib diisi. Satu penyimpanan membuat satu lot dan satu transaksi IN." Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel>
   <Grid Margin="22,0,22,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,10,20"><TextBlock Text="Jenis kopi *" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="CoffeeTypes" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="10,0,0,20"><TextBlock Text="Pemasok *" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="Suppliers" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,0,10,20"><TextBlock Text="Kode lot *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LotCode" MaxLength="40"/><TextBlock Text="Kode harus unik untuk setiap lot." Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel>
    <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,20"><TextBlock Text="Grade *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Grade" MaxLength="40"/></StackPanel>
    <StackPanel Grid.Row="2" Margin="0,0,10,20"><TextBlock Text="Asal *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Origin" MaxLength="100"/></StackPanel>
    <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,20"><TextBlock Text="Tanggal penerimaan *" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="ReceivedDate"/></StackPanel>
    <StackPanel Grid.Row="3" Margin="0,0,10,7"><TextBlock Text="Berat penerimaan (kg) *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Quantity"/><TextBlock Text="Lebih dari 0; maksimal 3 angka desimal." Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel>
    <StackPanel Grid.Row="3" Grid.Column="1" Margin="10,0,0,7"><TextBlock Text="Lokasi" Style="{StaticResource FieldLabel}"/><TextBox IsReadOnly="True" Text="Gudang Utama" Background="#F3EEE7"/><TextBlock Text="Lokasi tetap untuk semua penerimaan." Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel>
   </Grid>
   <Border Background="#F8F5F0" CornerRadius="8" Padding="12" Margin="22,5,22,17"><TextBlock Text="ⓘ  Setiap penerimaan membuat lot baru; stok bertambah setelah tersimpan." Style="{StaticResource MutedText}"/></Border>
   <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,15,22,16"><StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Bersihkan" Style="{StaticResource SecondaryButton}" Click="Clear_Click" Margin="0,0,10,0"/><Button Content="✓  Simpan penerimaan" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></StackPanel><TextBlock x:Name="Status" Foreground="{StaticResource Olive}" FontSize="12" FontWeight="SemiBold" Margin="0,13,0,0"/></StackPanel></Border>
  </StackPanel></Border>
  <StackPanel Grid.Column="1" Margin="12,0,0,0">
   <Border Style="{StaticResource DarkCard}" Padding="22" Margin="0,0,0,18"><StackPanel><TextBlock Text="♧" FontSize="28" Foreground="{StaticResource Latte}"/><TextBlock Text="Satu lot, satu asal." FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,10,0,16"/><TextBlock Text="Jenis kopi, pemasok, dan asal melekat pada lot agar setiap pengeluaran mudah ditelusuri." Foreground="#D0BBB0" FontSize="12"/><TextBlock Text="01  Lengkapi identitas lot&#10;02  Periksa tanggal dan berat&#10;03  Simpan penerimaan" Foreground="#E8D0C0" FontSize="12" Margin="0,19,0,0" LineHeight="28"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Penerimaan terakhir" Style="{StaticResource Subheading}"/><TextBlock Text="Data tersimpan · bukan draft" Style="{StaticResource MutedText}" Margin="0,4,0,13"/><TextBlock x:Name="LastLotCode" Text="Belum ada penerimaan" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="LastLotWeight" Foreground="{StaticResource Mocha}" FontSize="19" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock x:Name="LastLotDetails" Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Border>
  </StackPanel>
 </Grid>
</StackPanel></UserControl>
