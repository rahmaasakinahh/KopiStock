<UserControl x:Class="KopiStock.Views.LotDetailView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel>
 <Grid Margin="0,0,0,19"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Detail Lot Kopi" Style="{StaticResource H1}"/><TextBlock Text="Identitas lot dan pergerakan stok dalam satu tampilan hanya baca." Style="{StaticResource MutedText}" FontSize="13"/></StackPanel><Button Grid.Column="1" Content="←  Kembali ke Stok" Style="{StaticResource SecondaryButton}" Click="Back_Click" VerticalAlignment="Center"/></Grid>
 <Border Background="{StaticResource SoftLatte}" CornerRadius="8" Padding="12" Margin="0,0,0,19"><TextBlock Text="ⓘ  Rincian berasal dari database KopiStock. Stok dihitung otomatis berdasarkan transaksi IN dan OUT." Foreground="{StaticResource Mocha}" FontSize="12"/></Border>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width=".93*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
 <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Informasi lot" Style="{StaticResource Subheading}" Margin="0,0,0,17"/><TextBlock Text="Kode Lot" Style="{StaticResource MutedText}"/><TextBlock x:Name="LotCode" FontSize="26" FontWeight="Bold" Margin="0,3,0,17"/><TextBlock Text="Jenis Kopi" Style="{StaticResource MutedText}"/><TextBlock x:Name="CoffeeName" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,17"/><TextBlock Text="Nama Pemasok" Style="{StaticResource MutedText}"/><TextBlock x:Name="SupplierName" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,17"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Daerah Asal" Style="{StaticResource MutedText}"/><TextBlock x:Name="Origin" Margin="0,5,0,17" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Grade" Style="{StaticResource MutedText}"/><TextBlock x:Name="Grade" Margin="0,5,0,17" FontWeight="SemiBold"/></StackPanel></Grid><TextBlock Text="Tanggal Penerimaan" Style="{StaticResource MutedText}"/><TextBlock x:Name="ReceivedDate" FontWeight="SemiBold" Margin="0,5,0,17"/><TextBlock Text="Lokasi Penyimpanan" Style="{StaticResource MutedText}"/><TextBlock Text="Gudang Utama" Margin="0,5,0,0" FontWeight="SemiBold"/></StackPanel></Border>
 <StackPanel Grid.Column="1" Margin="12,0,0,0">
  <UniformGrid Columns="3" Margin="0,0,0,17"><Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Total Masuk (kg)" Style="{StaticResource MutedText}"/><TextBlock x:Name="InValue" Style="{StaticResource KpiNumber}"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="4,0,4,0"><StackPanel><TextBlock Text="Total Keluar (kg)" Style="{StaticResource MutedText}"/><TextBlock x:Name="OutValue" Style="{StaticResource KpiNumber}"/></StackPanel></Border><Border Background="{StaticResource SoftLatte}" CornerRadius="12" Padding="20" Margin="8,0,0,16"><StackPanel><TextBlock Text="Stok Tersedia (kg)" Foreground="{StaticResource Mocha}" FontSize="12"/><TextBlock x:Name="BalanceValue" Foreground="{StaticResource Mocha}" FontSize="30" FontWeight="SemiBold" Margin="0,13,0,5"/></StackPanel></Border></UniformGrid>
  <TextBlock Text="Stok tersedia = total transaksi IN valid − total transaksi OUT valid." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
  <Border Style="{StaticResource Card}" Padding="0"><StackPanel><TextBlock Text="Transaksi lot" Style="{StaticResource Subheading}" Margin="18,17,18,16"/><DataGrid x:Name="MovementsGrid" Height="262"><DataGrid.Columns><DataGridTextColumn Header="Tanggal &amp; waktu dicatat" Binding="{Binding RecordedAtLabel}" Width=".9*"/><DataGridTextColumn Header="Jenis" Binding="{Binding TypeLabel}" Width=".7*"/><DataGridTextColumn Header="Berat" Binding="{Binding QuantityLabel}" Width=".8*"/><DataGridTextColumn Header="Keterangan / tujuan" Binding="{Binding DestinationLabel}" Width="1.5*"/></DataGrid.Columns></DataGrid></StackPanel></Border>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Kembali ke Stok" Style="{StaticResource SecondaryButton}" Click="Back_Click"/><Button Content="↗  Catat Pengeluaran" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Click="Dispatch_Click"/></StackPanel>
 </StackPanel>
 </Grid>
</StackPanel></UserControl>
