<UserControl x:Class="KopiStock.Views.StockView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel>
 <Grid Margin="0,0,0,23"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Stok &amp; pengeluaran" Style="{StaticResource H1}"/><TextBlock Text="Periksa saldo setiap lot sebelum mencatat kopi keluar." Style="{StaticResource MutedText}" FontSize="13"/></StackPanel><Border Grid.Column="1" Background="{StaticResource SoftLatte}" CornerRadius="6" Padding="11,5" VerticalAlignment="Center"><TextBlock x:Name="StockSummary" Text="0 lot aktif · Total 0 kg" Foreground="{StaticResource Mocha}" FontSize="11" FontWeight="SemiBold"/></Border></Grid>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.9*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
 <StackPanel Margin="0,0,12,0">
  <Border Style="{StaticResource Card}" Padding="0"><StackPanel>
   <StackPanel Margin="20,18,20,14"><TextBlock Text="Persediaan lot" Style="{StaticResource Subheading}"/><TextBlock Text="Gudang Utama · Saldo terkini" Style="{StaticResource MutedText}" Margin="0,5,0,12"/><DockPanel><TextBox x:Name="Search" MinWidth="225" ToolTip="Cari kode lot" TextChanged="Search_TextChanged"/><Button DockPanel.Dock="Right" Content="Muat ulang" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="Refresh_Click"/></DockPanel></StackPanel>
   <DataGrid x:Name="LotGrid" Height="285" SelectionChanged="LotGrid_SelectionChanged"><DataGrid.Columns>
    <DataGridTextColumn Header="Kode lot" Binding="{Binding Code}" Width=".8*"/><DataGridTextColumn Header="Jenis" Binding="{Binding CoffeeName}" Width=".8*"/><DataGridTextColumn Header="Pemasok" Binding="{Binding SupplierName}" Width="1.4*"/><DataGridTextColumn Header="Grade" Binding="{Binding Grade}" Width=".7*"/><DataGridTextColumn Header="Sisa" Binding="{Binding BalanceLabel}" Width="1*"/>
   </DataGrid.Columns></DataGrid>
   <StackPanel Orientation="Horizontal" Margin="20,13,20,16"><Button Content="Lihat Detail Lot →" Style="{StaticResource SecondaryButton}" Click="Details_Click"/><TextBlock Text="   Pilih baris lot untuk melihat detail" Style="{StaticResource MutedText}" VerticalAlignment="Center"/></StackPanel>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Lot terpilih" Style="{StaticResource MutedText}"/><TextBlock x:Name="SelectedLot" Text="Belum ada lot yang dipilih" FontSize="19" FontWeight="SemiBold" Margin="0,9,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Diterima" Style="{StaticResource MutedText}"/><TextBlock x:Name="InSelected" Text="—" FontSize="21" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Dikeluarkan" Style="{StaticResource MutedText}"/><TextBlock x:Name="OutSelected" Text="—" FontSize="21" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Sisa tersedia" Style="{StaticResource MutedText}"/><TextBlock x:Name="BalanceSelected" Text="—" Foreground="{StaticResource Mocha}" FontSize="21" FontWeight="SemiBold"/></StackPanel></Grid></StackPanel></Border>
  <Border Background="{StaticResource SoftLatte}" CornerRadius="9" Padding="13" Margin="0,0,0,16"><TextBlock x:Name="Feedback" Text="Stok hanya berubah setelah transaksi berhasil disimpan." Foreground="{StaticResource Ink}" FontSize="12"/></Border>
 </StackPanel>
 <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" Margin="12,0,0,0"><StackPanel>
  <StackPanel Margin="20,20,20,17"><TextBlock Text="Pengeluaran kopi" Style="{StaticResource Subheading}" FontSize="18"/><TextBlock Text="Pilih lot pada tabel persediaan" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel>
  <Border Background="{StaticResource SoftLatte}" Padding="15" Margin="20,0,20,19" CornerRadius="7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Berat tersedia" Foreground="{StaticResource Mocha}" FontSize="12" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="StockAvailable" Text="—" FontSize="22" FontWeight="SemiBold"/></Grid></Border>
  <StackPanel Margin="20,0,20,15"><TextBlock Text="Berat pengeluaran (kg) *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Weight"/><TextBlock Text="Harus lebih dari 0, maksimal 3 angka desimal, dan tidak melebihi saldo terbaru." Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel>
  <StackPanel Margin="20,0,20,15"><TextBlock Text="Tanggal pengeluaran *" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="OutDate"/></StackPanel>
  <StackPanel Margin="20,0,20,25"><TextBlock Text="Tujuan *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Destination" MaxLength="100"/></StackPanel>
  <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}" Padding="20,16,20,16"><Button Content="✓  Simpan pengeluaran" Style="{StaticResource PrimaryButton}" Click="Dispatch_Click" HorizontalAlignment="Right"/></Border>
 </StackPanel></Border>
 </Grid>
</StackPanel></UserControl>
