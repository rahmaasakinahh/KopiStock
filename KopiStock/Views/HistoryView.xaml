<UserControl x:Class="KopiStock.Views.HistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel>
 <TextBlock Text="Riwayat transaksi" Style="{StaticResource H1}"/><TextBlock Text="Telusuri setiap pergerakan kopi. Catatan tersimpan tidak dapat diubah atau dihapus." Style="{StaticResource MutedText}" FontSize="13" Margin="0,0,0,24"/>
 <Border Style="{StaticResource Card}" Padding="0"><StackPanel>
  <StackPanel Margin="20,20,20,15"><TextBlock Text="Semua transaksi" Style="{StaticResource Subheading}"/><TextBlock Text="Gudang Utama · Urut dari transaksi terbaru. Waktu pencatatan lama bisa kosong." Style="{StaticResource MutedText}" Margin="0,4,0,18"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Cari kode lot" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Search" ToolTip="Cari kode lot" TextChanged="Filter_Changed"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Jenis transaksi" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="TypeFilter" SelectionChanged="Filter_Changed"><ComboBoxItem Content="Semua" IsSelected="True"/><ComboBoxItem Content="IN"/><ComboBoxItem Content="OUT"/></ComboBox></StackPanel><Button Grid.Column="2" Content="Reset filter" Style="{StaticResource SecondaryButton}" Click="Reset_Click" VerticalAlignment="Bottom"/></Grid>
  </StackPanel>
  <DataGrid x:Name="HistoryGrid" Height="328"><DataGrid.Columns><DataGridTextColumn Header="Tanggal transaksi" Binding="{Binding TransactionDateLabel}" Width="1*"/>
<DataGridTextColumn Header="Waktu dicatat" Binding="{Binding RecordedAtLabel}" Width="1.55*"/><DataGridTextColumn Header="Transaksi" Binding="{Binding TypeLabel}" Width=".8*"/><DataGridTextColumn Header="Kode lot" Binding="{Binding LotCode}" Width="1*"/><DataGridTextColumn Header="Berat" Binding="{Binding QuantityLabel}" Width="1*"/><DataGridTextColumn Header="Tujuan pengeluaran" Binding="{Binding DestinationLabel}" Width="1.6*"/><DataGridTextColumn Header="Pencatat" Binding="{Binding EnteredBy}" Width="1*"/></DataGrid.Columns></DataGrid>
  <Grid Margin="20,14,20,17"><TextBlock x:Name="RowsInfo" Text="0 transaksi ditemukan" Style="{StaticResource MutedText}"/><TextBlock Text="Maksimal 500 catatan terakhir" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></Grid>
 </StackPanel></Border>
 <Border Background="{StaticResource Coffee}" CornerRadius="10" Padding="22" Margin="0,4,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Ringkasan persediaan" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="Seluruh transaksi yang tersimpan" Foreground="#C9B8AA" FontSize="11" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="IN · Masuk" Foreground="#CFBCAF" FontSize="11"/><TextBlock x:Name="SumIn" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="OUT · Keluar" Foreground="#CFBCAF" FontSize="11"/><TextBlock x:Name="SumOut" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="Saldo bersih" Foreground="#CFBCAF" FontSize="11"/><TextBlock x:Name="SumBalance" Foreground="#E6B88C" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Grid></Border>
</StackPanel></UserControl>
