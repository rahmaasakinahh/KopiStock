<UserControl x:Class="KopiStock.Views.LoginView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Background="{StaticResource Cream}"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
 <Grid><Grid.Background><ImageBrush ImageSource="/KopiStock;component/Assets/coffee_warehouse.jpg" Stretch="UniformToFill"/></Grid.Background>
  <Border Background="#AC201510"/><Grid Margin="55,43,45,40"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal"><TextBlock Text="◌" FontSize="32" Foreground="{StaticResource Latte}" Margin="0,0,10,0"/><TextBlock Text="KopiStock" FontSize="28" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
   <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,75,0,0"><TextBlock Text="DARI ASAL, HINGGA TUJUAN." FontSize="11" FontWeight="SemiBold" Foreground="#E7C29B"/><TextBlock Text="Setiap biji tercatat.&#10;Setiap lot terjaga." FontSize="36" FontWeight="SemiBold" Foreground="White" Margin="0,15,0,15"/><TextBlock Text="Kelola penerimaan dan pengeluaran kopi dalam satu ruang kerja yang rapi dan terukur." FontSize="15" Foreground="#E7DAD2" MaxWidth="450"/></StackPanel>
   <Grid Grid.Row="2"><TextBlock Text="KOPI INDONESIA   ·   Kualitas dimulai dari pencatatan." Foreground="#E8D1BB" FontSize="11"/><TextBlock Text="KOPISTOCK / 2026" Foreground="#E8D1BB" FontSize="11" HorizontalAlignment="Right"/></Grid>
  </Grid>
 </Grid>
 <Grid Grid.Column="1" Background="{StaticResource Cream}"><StackPanel Width="460" HorizontalAlignment="Center" VerticalAlignment="Center">
  <TextBlock Text="⌂   Gudang Utama" Foreground="{StaticResource Mocha}" FontSize="12" Margin="0,0,0,25"/>
  <TextBlock Text="Selamat datang kembali." FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
  <TextBlock Text="Masuk untuk melanjutkan pencatatan stok kopi Anda." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,9,0,28"/>
  <TextBlock Text="Nama pengguna" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Username" Text="admin" Margin="0,0,0,18"/>
  <TextBlock Text="Kata sandi" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="Password" KeyDown="Password_KeyDown" Margin="0,0,0,8"/>
  <TextBlock x:Name="Feedback" Foreground="{StaticResource Error}" FontSize="12" Margin="0,4,0,12"/>
  <Button Content="→   Masuk" Style="{StaticResource PrimaryButton}" Height="47" Click="Login_Click"/>
  <Border Background="{StaticResource SoftLatte}" CornerRadius="9" Padding="13" Margin="0,20,0,0"><TextBlock Text="Akun demo untuk ETS: admin / Admin123!" Foreground="{StaticResource Muted}" FontSize="11"/></Border>
  <TextBlock Text="KopiStock · Inventori biji kopi untuk ekspor" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" Margin="0,32,0,0"/>
 </StackPanel></Grid>
</Grid></UserControl>
