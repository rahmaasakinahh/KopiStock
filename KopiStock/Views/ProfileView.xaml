<UserControl x:Class="KopiStock.Views.ProfileView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel>
 <TextBlock Text="Profil" Style="{StaticResource H1}"/><TextBlock Text="Informasi akun yang digunakan untuk pencatatan di Gudang Utama." Style="{StaticResource MutedText}" FontSize="13" Margin="0,0,0,24"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
  <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0"><StackPanel><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="{StaticResource SoftLatte}" Height="65" Width="65" CornerRadius="34"><TextBlock Text="AG" Foreground="{StaticResource Mocha}" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="15,6,0,0"><TextBlock x:Name="NameLabel" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Administrator · Gudang Utama" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="2" Background="#EEF4EA" Padding="9,4" CornerRadius="5" VerticalAlignment="Center"><TextBlock Text="Aktif" Foreground="{StaticResource Olive}" FontSize="11"/></Border></Grid></Border>
   <StackPanel Margin="20,20,20,20"><TextBlock Text="Informasi akun" Style="{StaticResource Subheading}"/><TextBlock Text="Nama tampilan berbeda dengan username yang dipakai saat login." Style="{StaticResource MutedText}" Margin="0,5,0,19"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,12,18"><TextBlock Text="Nama tampilan" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DisplayName" MaxLength="70"/></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,18"><TextBlock Text="Nama pengguna" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Username" IsReadOnly="True" Background="#F3EEE7"/></StackPanel><StackPanel Grid.Row="1" Margin="0,0,12,0"><TextBlock Text="Peran" Style="{StaticResource FieldLabel}"/><TextBlock Text="Administrator" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Gudang" Style="{StaticResource FieldLabel}"/><TextBlock Text="Gudang Utama" FontWeight="SemiBold"/></StackPanel></Grid>
    <TextBlock x:Name="Feedback" Foreground="{StaticResource Olive}" FontSize="12" Margin="0,20,0,9"/><Button Content="Simpan nama tampilan" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="Save_Click"/>
   </StackPanel>
  </StackPanel></Border>
  <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0"><StackPanel><TextBlock Text="Keamanan akun" Style="{StaticResource Subheading}" Margin="0,0,0,14"/><TextBlock Text="Akun ini digunakan secara internal untuk Gudang Utama. Keluar setelah selesai mencatat transaksi, khususnya di komputer bersama." Foreground="{StaticResource Muted}" FontSize="12"/><Border Background="#F8F3EC" CornerRadius="8" Padding="13" Margin="0,21,0,19"><TextBlock Text="ⓘ  Semua transaksi yang tersimpan tetap ada setelah Anda keluar dari aplikasi." Foreground="{StaticResource Muted}" FontSize="12"/></Border><TextBlock Text="Untuk keluar, pilih menu Keluar di sidebar." FontSize="12"/></StackPanel></Border>
 </Grid>
</StackPanel></UserControl>
