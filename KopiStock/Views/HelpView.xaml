<UserControl x:Class="KopiStock.Views.HelpView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel>
 <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Pusat Bantuan" Style="{StaticResource H1}"/><TextBlock Text="Temukan jawaban dan panduan penggunaan KopiStock." Style="{StaticResource MutedText}" FontSize="13"/></StackPanel><TextBox x:Name="FaqSearch" Grid.Column="1" Width="290" MinHeight="40" VerticalAlignment="Center" ToolTip="Cari pertanyaan" TextChanged="SearchFaq_TextChanged"/></Grid>
 <TextBlock Text="Pertanyaan umum" Style="{StaticResource Subheading}" Margin="0,0,0,13"/>
 <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0">
  <Border x:Name="BoxQ1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,9"><Expander x:Name="Faq1" Header="Bagaimana cara menambahkan stok biji kopi?" IsExpanded="True"><TextBlock Text="Buka menu Penerimaan, lengkapi data lot, jenis kopi, pemasok, grade, asal, tanggal, dan berat. Klik Simpan untuk mencatat penerimaan." Style="{StaticResource MutedText}" Margin="0,10,0,0"/></Expander></Border>
  <Border x:Name="BoxQ2" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,9"><Expander x:Name="Faq2" Header="Mengapa transaksi pengeluaran saya ditolak?" IsExpanded="True"><TextBlock Text="Jumlah harus lebih dari nol dan tidak boleh melebihi stok tersedia pada lot. Berat maksimal tiga desimal." Style="{StaticResource MutedText}" Margin="0,10,0,0"/></Expander></Border>
  <Border x:Name="BoxQ3" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,9"><Expander x:Name="Faq3" Header="Bagaimana cara mengetahui stok tersedia?" IsExpanded="True"><TextBlock Text="Buka Stok &amp; Pengeluaran. Saldo setiap lot dihitung otomatis dari transaksi yang sudah dicatat." Style="{StaticResource MutedText}" Margin="0,10,0,0"/></Expander></Border>
 </StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0">
  <Border x:Name="BoxQ4" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,9"><Expander x:Name="Faq4" Header="Bagaimana cara mencatat pengeluaran kopi?" IsExpanded="True"><TextBlock Text="Buka Stok &amp; Pengeluaran, pilih lot, lalu isi berat, tanggal, tujuan, dan simpan transaksi." Style="{StaticResource MutedText}" Margin="0,10,0,0"/></Expander></Border>
  <Border x:Name="BoxQ5" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,9"><Expander x:Name="Faq5" Header="Bagaimana cara melihat riwayat transaksi?" IsExpanded="True"><TextBlock Text="Buka Riwayat untuk melihat tanggal, kode lot, berat, dan jenis transaksi IN/OUT." Style="{StaticResource MutedText}" Margin="0,10,0,0"/></Expander></Border>
  <Border x:Name="BoxQ6" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,9"><Expander x:Name="Faq6" Header="Apakah data tetap tersimpan setelah aplikasi ditutup?" IsExpanded="True"><TextBlock Text="Ya. Semua transaksi yang berhasil disimpan tetap tersedia di database SQLite lokal." Style="{StaticResource MutedText}" Margin="0,10,0,0"/></Expander></Border>
 </StackPanel></Grid>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width=".9*"/><ColumnDefinition Width="1.65*"/></Grid.ColumnDefinitions>
  <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Masih Membutuhkan Bantuan?" Style="{StaticResource Subheading}" Margin="0,0,0,10"/><TextBlock Text="Jika FAQ belum menyelesaikan kendala, sampaikan laporan kepada penanggung jawab aplikasi." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,22"/><TextBlock Text="Kontak penanggung jawab" Style="{StaticResource FieldLabel}"/><TextBlock Text="Belum diisi kelompok" Foreground="{StaticResource Mocha}" Margin="0,0,0,19"/><TextBlock Text="Email bantuan" Style="{StaticResource FieldLabel}"/><TextBlock Text="Belum diisi kelompok" Foreground="{StaticResource Mocha}"/><TextBlock Text="Kontak akan ditentukan kelompok sebelum demo akhir." Style="{StaticResource MutedText}" Margin="0,22,0,0"/></StackPanel></Border>
  <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0"><StackPanel><TextBlock Text="Laporan Kendala" Style="{StaticResource Subheading}"/><TextBlock Text="Siapkan pesan untuk disalin dan dikirim ke admin. Tidak memakai server atau tiket." Style="{StaticResource MutedText}" Margin="0,5,0,15"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,11"><TextBlock Text="Nama pengguna *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Reporter" Text="admin"/></StackPanel><StackPanel Grid.Column="1" Margin="10,0,0,11"><TextBlock Text="Kategori kendala *" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="Category"><ComboBoxItem Content="Login"/><ComboBoxItem Content="Data Master"/><ComboBoxItem Content="Penerimaan"/><ComboBoxItem Content="Pengeluaran"/><ComboBoxItem Content="Lainnya"/></ComboBox></StackPanel></Grid>
   <TextBlock Text="Deskripsi kendala *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Description" Height="82" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,0,13"/>
   <Button Content="Salin Laporan" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="CopyReport_Click"/><TextBlock x:Name="Feedback" Foreground="{StaticResource Olive}" FontSize="12" Margin="0,13,0,0"/>
  </StackPanel></Border>
 </Grid>
</StackPanel></UserControl>
