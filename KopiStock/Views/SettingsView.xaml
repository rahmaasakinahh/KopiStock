<UserControl x:Class="KopiStock.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <TextBlock Text="Pengaturan" Style="{StaticResource H1}"/>
  <TextBlock Text="Atur kenyamanan tampilan dan lihat informasi instalasi KopiStock." Style="{StaticResource MutedText}" FontSize="13" Margin="0,0,0,22"/>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
   <StackPanel Grid.Column="0" Margin="0,0,12,0">
    <Border Style="{StaticResource Card}">
     <StackPanel>
      <TextBlock Text="Preferensi tampilan" Style="{StaticResource Subheading}"/>
      <TextBlock Text="Sesuaikan jarak antarbaris di seluruh tabel inventaris." Style="{StaticResource MutedText}" Margin="0,5,0,19"/>
      <TextBlock Text="Kerapatan tabel" Style="{StaticResource FieldLabel}"/>
      <Grid Margin="0,6,0,8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
       <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,6,0" Background="#F7F0E8">
        <StackPanel><RadioButton x:Name="DensityComfort" GroupName="density" Content="Nyaman" FontWeight="SemiBold" Foreground="{StaticResource Ink}" IsChecked="True"/>
         <TextBlock Text="Baris lebih lapang" Style="{StaticResource MutedText}" Margin="23,7,0,0"/></StackPanel>
       </Border>
       <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="6,0,0,0">
        <StackPanel><RadioButton x:Name="DensityCompact" GroupName="density" Content="Ringkas" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
         <TextBlock Text="Lebih banyak baris" Style="{StaticResource MutedText}" Margin="23,7,0,0"/></StackPanel>
       </Border>
      </Grid>
      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="PreferenceFeedback" Text="Terapkan, lalu buka ulang halaman tabel." Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <Button Grid.Column="1" Content="Terapkan" Style="{StaticResource PrimaryButton}" Click="Apply_Click"/>
       </Grid>
      </Border>
     </StackPanel>
    </Border>
    <Border Background="{StaticResource SoftLatte}" CornerRadius="9" Padding="15" Margin="0,0,0,16">
     <StackPanel><TextBlock Text="Catatan" FontWeight="SemiBold" Foreground="{StaticResource Mocha}" Margin="0,0,0,6"/>
      <TextBlock Text="Preferensi tampilan hanya memengaruhi jarak tabel, bukan stok, lot, atau transaksi." Foreground="{StaticResource Ink}" FontSize="12" TextWrapping="Wrap"/></StackPanel>
    </Border>
   </StackPanel>
   <StackPanel Grid.Column="1" Margin="12,0,0,0">
    <Border Style="{StaticResource Card}">
     <StackPanel>
      <TextBlock Text="Informasi gudang" Style="{StaticResource Subheading}"/>
      <TextBlock Text="Satu gudang · hanya baca" Style="{StaticResource MutedText}" Margin="0,5,0,18"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,12,12"><TextBlock Text="Nama gudang" Style="{StaticResource MutedText}"/>
        <TextBlock Text="Gudang Utama" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="12,0,0,12"><TextBlock Text="Satuan berat" Style="{StaticResource MutedText}"/>
        <TextBlock Text="Kilogram (kg)" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
      </Grid>
      <TextBlock Text="Jenis sistem" Style="{StaticResource MutedText}"/>
      <TextBlock Text="Inventaris Gudang Biji Kopi" FontWeight="SemiBold" Margin="0,5,0,0"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}">
     <StackPanel>
      <TextBlock Text="Informasi aplikasi" Style="{StaticResource Subheading}"/>
      <TextBlock Text="Versi dan lokasi penyimpanan data" Style="{StaticResource MutedText}" Margin="0,5,0,18"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,12,14"><TextBlock Text="Aplikasi" Style="{StaticResource MutedText}"/>
        <TextBlock Text="KopiStock · 1.0" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="12,0,0,14"><TextBlock Text="Database" Style="{StaticResource MutedText}"/>
        <TextBlock Text="SQLite lokal" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
      </Grid>
      <TextBlock Text="Lokasi file database" Style="{StaticResource FieldLabel}"/>
      <Border Background="#F8F4EF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="11,11" Margin="0,5,0,13">
       <TextBlock x:Name="PathDisplay" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Ink}"/>
      </Border>
      <WrapPanel><Button Content="Buka folder" Style="{StaticResource PrimaryButton}" Click="OpenFolder_Click" Margin="0,0,10,8"/>
       <Button Content="Salin lokasi" Style="{StaticResource SecondaryButton}" Click="Copy_Click" Margin="0,0,0,8"/></WrapPanel>
      <TextBlock Text="Cadangkan database hanya saat KopiStock ditutup." Style="{StaticResource MutedText}" Margin="0,9,0,0"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </Grid>
 </StackPanel>
</UserControl>