digraph KopiStock {
 graph [rankdir=LR, bgcolor="#F9F4ED", pad="0.34", nodesep="0.68", ranksep="1.2", splines=ortho];
 node [shape=plain, fontname="DejaVu Sans"];
 edge [color="#9A7357", arrowsize=0.72, penwidth=1.6];
 Users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#C7B3A3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#4B3028"><FONT COLOR="white"><B>Users</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id INTEGER</TD></TR><TR><TD></TD><TD ALIGN="LEFT">username TEXT UNIQUE</TD></TR><TR><TD></TD><TD ALIGN="LEFT">password_hash TEXT</TD></TR><TR><TD></TD><TD ALIGN="LEFT">display_name TEXT</TD></TR></TABLE>>];
 CoffeeTypes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#C7B3A3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#76503E"><FONT COLOR="white"><B>CoffeeTypes</B></FONT></TD></TR><TR><TD>PK</TD><TD ALIGN="LEFT">id INTEGER</TD></TR><TR><TD></TD><TD ALIGN="LEFT">name TEXT UNIQUE</TD></TR><TR><TD></TD><TD ALIGN="LEFT">status INTEGER</TD></TR></TABLE>>];
 Suppliers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#C7B3A3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#76503E"><FONT COLOR="white"><B>Suppliers</B></FONT></TD></TR><TR><TD>PK</TD><TD ALIGN="LEFT">id INTEGER</TD></TR><TR><TD></TD><TD ALIGN="LEFT">name TEXT</TD></TR><TR><TD></TD><TD ALIGN="LEFT">contact TEXT</TD></TR><TR><TD></TD><TD ALIGN="LEFT">status INTEGER</TD></TR></TABLE>>];
 CoffeeLots [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#C7B3A3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#76503E"><FONT COLOR="white"><B>CoffeeLots</B></FONT></TD></TR><TR><TD>PK</TD><TD ALIGN="LEFT">id INTEGER</TD></TR><TR><TD></TD><TD ALIGN="LEFT">code TEXT UNIQUE</TD></TR><TR><TD>FK</TD><TD ALIGN="LEFT">coffee_type_id</TD></TR><TR><TD>FK</TD><TD ALIGN="LEFT">supplier_id</TD></TR><TR><TD></TD><TD ALIGN="LEFT">grade TEXT</TD></TR><TR><TD></TD><TD ALIGN="LEFT">origin TEXT</TD></TR><TR><TD></TD><TD ALIGN="LEFT">received_at TEXT</TD></TR></TABLE>>];
 StockMovements [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#C7B3A3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#4B3028"><FONT COLOR="white"><B>StockMovements</B></FONT></TD></TR><TR><TD>PK</TD><TD ALIGN="LEFT">id INTEGER</TD></TR><TR><TD>FK</TD><TD ALIGN="LEFT">lot_id</TD></TR><TR><TD></TD><TD ALIGN="LEFT">type TEXT (IN / OUT)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">quantity_g INTEGER</TD></TR><TR><TD></TD><TD ALIGN="LEFT">happened_at TEXT (tanggal)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">created_at TEXT (jam input)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">destination TEXT</TD></TR><TR><TD>FK</TD><TD ALIGN="LEFT">user_id</TD></TR></TABLE>>];
 CoffeeTypes -> CoffeeLots [label=" 1 : N"];
 Suppliers -> CoffeeLots [label=" 1 : N"];
 CoffeeLots -> StockMovements [label=" 1 : N"];
 Users -> StockMovements [label=" 1 : N"];
}
